@misc{sieres2026guerilla,
  abbr      = {Article},
  title     = {La guérilla urbaine et la modélisation mathématique},
  author    = {Sieres, José and Sieres, Jean},
  year      = {2026},
  month     = {nov},
  abstract  = {La modélisation de la guérilla urbaine constitue un défi scientifique et stratégique, au croisement de la science militaire, de la théorie des jeux et des mathématiques appliquées. En transposant des dynamiques de combat asymétriques et non conventionnelles en modèles quantitatifs, ces travaux cherchent à formaliser l'imprévisibilité de l'engagement en milieu urbain. Ce cadre d'analyse permet d'anticiper les seuils de basculement, d'évaluer l'impact du cloisonnement spatial et d'éclairer les mécanismes d'escalade dans les conflits en zone urbaine.},
  pdf       = {guerilla_urbaine_modelisation.pdf},
}

@mastersthesis{sieres2026rl,
  abbr      = {Mémoire},
  title     = {Des processus de décision markoviens à l'apprentissage par renforcement},
  author    = {Siérès, Jean},
  year      = {2026},
  abstract  = {Ce mémoire montre comment la modélisation des problèmes de décision séquentielle par les processus de décision markoviens conduit aux méthodes d'apprentissage par renforcement. Il présente les chaînes de Markov, les processus de décision markoviens et les équations de Bellman, puis la programmation dynamique, lorsque le modèle de l'environnement est connu, et les méthodes de Monte-Carlo, les différences temporelles, SARSA et Q-learning, lorsqu'il ne l'est pas. Une étude expérimentale sur un environnement de type Gridworld compare ces méthodes, avec la programmation dynamique comme référence : toutes apprennent un chemin optimal, à des vitesses différentes, et Q-learning trouve un chemin plus court mais plus risqué que SARSA, plus prudent.},
  pdf       = {memoire_rl.pdf},
  selected  = {true},
}

@misc{xiao2024flocking,
  abbr         = {Mémoire},
  title        = {Étude d'un modèle de mouvement collectif},
  author       = {Xiao, Yuguang and Sieres, Jean and Li, Albert},
  year         = {2024},
  month        = {may},
  howpublished = {Projet de licence de mathématiques (LU3MA201), Sorbonne Université},
  abstract     = {Ce mémoire étudie l'émergence de comportements collectifs, comme les bancs de poissons ou les vols d'oiseaux, à partir du modèle à trois zones : répulsion à courte distance, alignement à moyenne distance et attraction à longue distance (Cao, Motsch, Reamy et Theisen, « Asymptotic flocking for the three-zone model »). Les simulations numériques, par la méthode d'Euler explicite et par Runge-Kutta d'ordre 4, dans le plan et dans l'espace, montrent comment la forme des interactions décide de l'apparition d'un groupe cohérent. Le modèle est ensuite étendu avec des prédateurs, puis avec des murs carrés et circulaires, pour mesurer l'effet de menaces extérieures et de conditions aux bords sur la dynamique du groupe.},
  pdf          = {Etude_d_un_modele_de_mouvement_collectif.pdf},
}
